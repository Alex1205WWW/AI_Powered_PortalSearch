# Copy to .env and fill in. Never commit .env.
APP_ENV=prod
LOG_LEVEL=INFO
TIMEZONE=Europe/Lisbon

# Postgres. Compose builds DATABASE_URL for the containers from these three.
POSTGRES_USER=imoveis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=imoveis
# Only used when running outside Docker (local development):
DATABASE_URL=postgresql+psycopg://imoveis:change-me@127.0.0.1:5432/imoveis

# Panel
SESSION_SECRET=change-me-long-random-string
ADMIN_USERNAME=andreia
# python -m app.cli hash-password "a password"  -> paste the printed line. Keep the single quotes: the hash contains '$',
# which docker compose would otherwise interpolate as variables and silently truncate the hash (login would fail).
ADMIN_PASSWORD_HASH=''
PANEL_HOST=andreia-imoveis.duckdns.org
PANEL_BASE_URL=https://andreia-imoveis.duckdns.org

# Crawling
# Quoted on purpose: the parentheses make this invalid shell if anything sources .env.
HTTP_USER_AGENT='ImoveisBot/0.1 (+mailto:contact@example.com)'
HTTP_DEFAULT_DELAY_S=2.0
HTTP_TIMEOUT_S=30

# Telegram: one bot, one chat (hers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SPACING_S=3

# AI: keys in her name, spend caps set at the provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MODEL_PROFILER=claude-sonnet-5
AI_CAP_CENTS_MONTH=500

# Idealista alert mailbox (Gmail + App Password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Backups (nightly worker job)
BACKUP_DIR=/backups
BACKUP_KEEP=14
